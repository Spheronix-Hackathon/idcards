# ========================================================
# SPHERONIX ID GENERATOR - BACKEND CONFIGURATION TEMPLATE
# ========================================================

PORT=5000
NODE_ENV=production

# MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/spheronix_id_card?retryWrites=true&w=majority

# Allowed Frontend Origins (Comma-separated for multiple ports and domains)
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://your-frontend.vercel.app

# JWT Secret
JWT_SECRET=replace_with_a_long_random_secret_key
JWT_EXPIRES_IN=24h

# Concurrency Gate (Max parallel students processing at the same time)
MAX_CONCURRENT_STUDENTS=10

# Campus Wi-Fi Rate Limits
RATE_LIMIT_REGISTRATION_MAX=500
RATE_LIMIT_RETRIEVAL_MAX=1000
RATE_LIMIT_LOGIN_MAX=50

# Cloudflare R2 Storage
R2_ACCOUNT_ID=2ea290b9ed1a115df185ff5666289541
R2_ENDPOINT=https://2ea290b9ed1a115df185ff5666289541.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=idcard
